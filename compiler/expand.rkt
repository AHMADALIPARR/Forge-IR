#lang racket/base

(require racket/file racket/list racket/string)
(provide compile-forge forge-source->ir)

(struct tok (text line column) #:transparent)
(struct source-module (name type-name functor program) #:transparent)
(struct functor-def (name args result-type execute-left execute-right proof-left proof-right) #:transparent)
(struct program-def (name lets invoke args assertion) #:transparent)
(struct instruction (op args) #:transparent)

(define (bad where fmt . xs)
  (raise-arguments-error where (apply format fmt xs)))

(define (lex src)
  (define n (string-length src))
  (define out '())
  (define line 1)
  (define col 1)
  (let loop ([i 0])
    (when (< i n)
      (define c (string-ref src i))
      (cond
        [(char=? c #\newline) (set! line (add1 line)) (set! col 1) (loop (add1 i))]
        [(char-whitespace? c) (set! col (add1 col)) (loop (add1 i))]
        [(char-alphabetic? c)
         (define start i)
         (define start-col col)
         (let scan ([j i])
           (if (and (< j n)
                    (let ([x (string-ref src j)])
                      (or (char-alphabetic? x) (char-numeric? x) (char=? x #\_))))
               (scan (add1 j))
               (begin
                 (set! out (cons (tok (substring src start j) line start-col) out))
                 (set! col (+ col (- j i)))
                 (loop j))))]
        [(char-numeric? c)
         (define start i)
         (define start-col col)
         (let scan ([j i])
           (if (and (< j n) (char-numeric? (string-ref src j)))
               (scan (add1 j))
               (begin
                 (set! out (cons (tok (substring src start j) line start-col) out))
                 (set! col (+ col (- j i)))
                 (loop j))))]
        [(or (char=? c #\,) (char=? c #\=))
         (define punct (string c))
         (set! out (cons (tok punct line col) out))
         (set! col (add1 col))
         (loop (add1 i))]
        [else (bad 'lexer "unexpected character ~a at ~a:~a" c line col)])))
  (list->vector (reverse out)))

(define (parse src)
  (define ts (lex src))
  (define p 0)
  (define (peek) (and (< p (vector-length ts)) (tok-text (vector-ref ts p))))
  (define (take!) (if (peek) (let ([x (tok-text (vector-ref ts p))]) (set! p (add1 p)) x)
                      (bad 'parser "unexpected end of source")))
  (define (expect! x) (define got (take!)) (unless (string=? got x) (bad 'parser "expected ~a, received ~a" x got)))
  (define (identifier!)
    (define x (take!))
    (unless (regexp-match? #px"^[A-Za-z_][A-Za-z0-9_]*$" x)
      (bad 'parser "expected identifier, received ~a" x)) x)
  (define (uint!)
    (define x (take!))
    (unless (regexp-match? #px"^(0|[1-9][0-9]*)$" x) (bad 'parser "invalid unsigned integer ~a" x))
    (define v (string->number x))
    (when (> v 9223372036854775807) (bad 'parser "v1 source integer exceeds the signed 64-bit canonical IR range")) v)
  (expect! "MODULE")
  (define module-name (identifier!))
  (expect! "TYPE")
  (define type-name (identifier!))
  (expect! "=")
  (expect! "UNSIGNED")
  (expect! "64")
  (expect! "FUNCTOR")
  (define functor-name (identifier!))
  (expect! "ACCEPT") (expect! "UNSIGNED") (expect! "64")
  (define arg-a (identifier!))
  (expect! "ACCEPT") (expect! "UNSIGNED") (expect! "64")
  (define arg-b (identifier!))
  (when (string=? arg-a arg-b) (bad 'parser "functor arguments must have distinct names"))
  (expect! "RETURN") (expect! "UNSIGNED") (expect! "64")
  (expect! "EXECUTE")
  (define exec-left (identifier!))
  (expect! "TIMES")
  (define exec-right (identifier!))
  (expect! "INTO") (expect! "RESULT")
  (expect! "END")
  (expect! "PROVE")
  (expect! "RESULT") (expect! "EQUALS")
  (define proof-left (identifier!))
  (expect! "TIMES")
  (define proof-right (identifier!))
  (expect! "END")
  (expect! "END")
  (expect! "PROGRAM")
  (define program-name (identifier!))
  (expect! "LET") (define let-a (identifier!)) (expect! "BE") (define value-a (uint!))
  (expect! "LET") (define let-b (identifier!)) (expect! "BE") (define value-b (uint!))
  (when (or (string=? let-a let-b) (string=? let-a arg-a) (string=? let-a arg-b)
            (string=? let-b arg-a) (string=? let-b arg-b))
    (bad 'parser "program and functor binding names must not collide"))
  (expect! "INVOKE") (define invoke-name (identifier!)) (expect! "WITH")
  (define invoke-a (identifier!)) (expect! ",") (define invoke-b (identifier!))
  (expect! "ASSERT") (expect! "RESULT") (expect! "EQUALS") (define assertion (uint!))
  (expect! "END")
  (when (peek) (bad 'parser "unexpected trailing token ~a" (peek)))
  (source-module module-name type-name
    (functor-def functor-name (list arg-a arg-b) type-name exec-left exec-right proof-left proof-right)
    (program-def program-name (list (cons let-a value-a) (cons let-b value-b)) invoke-name
                 (list invoke-a invoke-b) assertion)))

(define (validate ast)
  (define f (source-module-functor ast))
  (define p (source-module-program ast))
  (define args (functor-def-args f))
  (unless (and (string=? (functor-def-execute-left f) (first args))
               (string=? (functor-def-execute-right f) (second args))
               (string=? (functor-def-proof-left f) (first args))
               (string=? (functor-def-proof-right f) (second args)))
    (bad 'semantic-check "functor execution and proof expressions must match accepted arguments in order"))
  (unless (string=? (program-def-invoke p) (functor-def-name f))
    (bad 'semantic-check "program invokes unknown functor ~a" (program-def-invoke p)))
  (unless (equal? (program-def-args p) (map car (program-def-lets p)))
    (bad 'semantic-check "invocation arguments must match LET bindings in declaration order"))
  (define result (* (cdar (program-def-lets p)) (cdr (second (program-def-lets p)))))
  (unless (<= -9223372036854775808 result 9223372036854775807)
    (bad 'semantic-check "constant multiplication overflows signed 64-bit result"))
  (unless (= result (program-def-assertion p))
    (bad 'semantic-check "ASSERT mismatch: computed ~a, asserted ~a" result (program-def-assertion p)))
  ast)

(define (emit-ir ast)
  (define p (source-module-program ast))
  (define a (cdar (program-def-lets p)))
  (define b (cdr (second (program-def-lets p))))
  (define lines
    (list "FORGE-IR 1"
          "MODULE 1"
          "FUNC 0 0 3"
          (format "CONST 0 ~a" a)
          (format "CONST 1 ~a" b)
          "MUL 2 0 1"
          "RETURN 2"
          "ENDFUNC"
          "ENDMODULE"))
  (string->bytes/utf-8 (string-append (string-join lines "\n") "\n")))

(define (forge-source->ir source)
  (emit-ir (validate (parse source))))

(define (compile-forge input output)
  (define source (file->string input))
  (define bytes (forge-source->ir source))
  (call-with-output-file output
    (lambda (out) (write-bytes bytes out))
    #:exists 'replace)
  output)

(module+ main
  (require racket/cmdline)
  (define input #f)
  (define output "module.fir")
  (command-line
   #:program "forge-expand"
   #:args (source [target])
   (set! input source)
   (when target (set! output target)))
  (compile-forge input output))
