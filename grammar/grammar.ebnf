#lang racket/base
(provide (struct-out tok) keyword? keyword-list punctuation?)

(struct tok (type lexeme line col span) #:transparent)

(define keyword-list
  '(MODULE TYPE FUNCTOR PROGRAM ACCEPT RETURN EXECUTE PROVE END
    LET BE INVOKE WITH ASSERT INTO RESULT UNSIGNED BOOLEAN
    EQUALS NOT-EQUALS LESS-THAN GREATER-THAN PLUS MINUS
    TIMES DIVIDED-BY REMAINDER))

(define keyword-table (for/hash ([k keyword-list]) (values k #t)))
(define (keyword? s) (hash-ref keyword-table (string->symbol s) #f))

