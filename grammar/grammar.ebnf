MODULE Memory

TYPE
    Cell = UNSIGNED 8

FUNCTOR Combine
    ACCEPT Cell hi
    ACCEPT Cell lo
    RETURN Cell
    EXECUTE
        hi TIMES 2 PLUS lo INTO RESULT
    END
    PROVE
        RESULT GREATER-THAN hi
    END
END

MODULE Stacks

TYPE
    Item = UNSIGNED 32

FUNCTOR Peek
    ACCEPT Item top
    RETURN Item
    EXECUTE
        top INTO RESULT
    END
    PROVE
        RESULT EQUALS top
    END
END

PROGRAM Main
    LET a BE 7
    INVOKE Peek WITH a
    ASSERT RESULT EQUALS 7
END
