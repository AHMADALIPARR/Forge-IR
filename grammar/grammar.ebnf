(provide (struct-out diag) diag-error? error->string)
(struct diag (stage severity message line col span) #:transparent)
(define (diag-error? d) (eq? (diag-severity d) 'error))
(define (error->string d src-name)
  (format "~a:~a:~a: ~a: ~a" src-name (diag-line d) (diag-col d) (diag-stage d) (diag-message d)))

#lang racket/base
(require "tokens.rkt" "diagnostics.rkt")
(provide lex-source)

;; returns (values (listof tok?) (listof diag?))
(define (lex-source src)
  (define len (string-length src))
  (define (scan)
    (let loop ([i 0] [line 1] [col 1] [acc '()])
      ...))
  ...)

(define (lex-source src)
  (define len (string-length src))
  (define diags '())
  (define (err msg i line col)
    (set! diags (cons (diag 'lex 'error msg line col 1) diags)))
  (define toks
    (let loop ([i 0] [line 1] [col 1] [acc '()])
      (cond
        [(>= i len) (cons (tok 'EOF "" line col 0) (reverse acc))]
        [else
         (define c (string-ref src i))
         (cond
           [(char=? c #\newline)
            (loop (add1 i) (add1 line) 1 acc)]
           [(char-whitespace? c)
            (loop (add1 i) line (add1 col) acc)]
           [(char=? c #\#)
            (let skip ([j i] [l line])
              (cond [(or (>= j len) (char=? (string-ref src j) #\newline)) (loop j l 1 acc)]
                    [else (skip (add1 j) l)]))]

           [(char-numeric? c)
            (let scan ([j i])
              (if (and (< j len) (or (char-numeric? (string-ref src j))
                                     (char=? (string-ref src j) #\_)))
                  (scan (add1 j)) j))]

(define productions
  '((program MODULE IDENT type-section functor* program-section)
    ...))
(define (expected-first nt) ...)

(struct ps (toks pos diags) #:transparent) ; mutable? use set! on a box

(define (parse-tokens toks)
  (define pos 0)
  (define diags '())
  (define (peek) (list-ref toks pos))
  (define (advance!) (set! pos (add1 pos)))
  ...
(struct loc (line col) #:transparent) ; actually embed line/col directly in nodes

(struct src-loc (line col span) #:transparent)
(struct Program (module types functors main loc) ...)
(struct TypeDef (name width loc))
(struct Param (name type loc))
(struct Functor (name params ret body prove loc))
(struct NamedType (name loc))
(struct UnsignedType (width loc))
(struct BoolType (loc))
(struct Let (name expr loc))
(struct Invoke (name args loc))
(struct Assert (expr loc))
(struct ExprInto (expr target loc))
(struct Num (value loc))
(struct Ref (name loc))
(struct ResultRef (loc))
(struct Bin (op lhs rhs loc))
(struct Cmp (op lhs rhs loc))

