program := module-decl type-section functor-section* program-decl
module-decl := "MODULE" IDENT
type-section := "TYPE" (type-def)+
type-def := IDENT "=" "UNSIGNED" NUMBER
functor := "FUNCTOR" IDENT accept* return? body
accept := "ACCEPT" type-ident IDENT
return := "RETURN" type-ident
body := execute-block prove-block
execute-block := "EXECUTE" statement* "END"
prove-block := "PROVE" assertion* "END"
statement := let-stmt | invoke-stmt | expr-into-stmt | assert-stmt
let-stmt := "LET" IDENT "BE" expr
invoke-stmt := "INVOKE" IDENT ("WITH" expr ("," expr)*)?
assert-stmt := "ASSERT" expr
expr-into := expr "INTO" target (target := "RESULT" | IDENT)
expr := comparison
comparison := additive (("EQUALS"|"NOT-EQUALS"|"LESS-THAN"|"GREATER-THAN") additive)?
additive := multiplicative (("PLUS"|"MINUS") multiplicative)*
multiplicative := primary (("TIMES"|"DIVIDED-BY"|"REMAINDER") primary)*
primary := NUMBER | IDENT | "RESULT" | "(" expr ")"

(forge-ir (version 1) (module Arithmetic)
  (types (Word (unsigned 64)))
  (functor Multiply ((a Word) (b Word)) Word
    (exec
      (into result (times (ref a) (ref b))))
    (prove
      (assert (equals result (times (ref a) (ref b))))))
  (program Main
    (let x (unsigned 64) (lit 12))
    (let y (unsigned 64) (lit 8))
    (invoke Multiply (ref x) (ref y))
    (assert (equals result (lit 96)))))

