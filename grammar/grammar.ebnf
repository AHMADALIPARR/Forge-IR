#lang racket/base
(require "tokens.rkt" "diagnostics.rkt")
(provide lex-source token-dump-line)

(define (lex-source src)
  (define len (string-length src))
  (define diags '())
  (define (add-diag! msg line col)
    (set! diags (cons (diag 'lex 'error msg line col 1) diags)))
  (define-values (toks-rev _l _c)
    (let loop ([i 0] [line 1] [col 1] [acc '()])
      (cond
        [(>= i len) (values acc line col)]
        [else
         (define c (string-ref src i))
         (cond
           [(char=? c #\newline) (loop (add1 i) (add1 line) 1 acc)]
           [(char-whitespace? c) (loop (add1 i) line (add1 col) acc)]
           [(char=? c #\#)
            (let skip ([j (add1 i)])
              (cond
                [(>= j len) (values acc line col)]
                [(char=? (string-ref src j) #\newline) (loop j line col acc)]
                [else (skip (add1 j))]))]

       [(char-numeric? c)
        (let scan ([j i])
          (if (or (>= j len)
                  (not (or (char-numeric? (string-ref src j))
                           (char=? (string-ref src j) #\_))))
              (begin
                (define lex (substring src i j))
                (loop j line (+ col (- j i))
                      (cons (tok 'NUMBER lex line col (- j i)) acc)))
              (scan (add1 j))))]
       [(or (char-alphabetic? c) (char=? c #\_) (char=? c #\$))
        (let scan ([j i])
          (if (or (>= j len)
                  (not (or (char-alphabetic? (string-ref src j))
                           (char-numeric? (string-ref src j))
                           (char=? (string-ref src j) #\_))))
              (begin
                (define lex (substring src i j))
                (define sym (string->symbol lex))
                (loop j line (+ col (- j i))
                      (cons (tok (if (keyword? sym) sym 'IDENT) lex line col (- j i)) acc)))
              (scan (add1 j))))]

       [(char=? c #\,) (loop (add1 i) line (add1 col) (cons (tok 'COMMA "," line col 1) acc))]
       [(char=? c #\() ...
       [(char=? c #\)) ...
       [(char=? c #\=) (loop ... 'EQSIGN "=" ...)]
       [else (add-diag! (format "unexpected character '~a'" c) line col)
             (values acc line col)])]))


Hmm `(define-values (toks-rev _l _c) (let loop ...))` with named-let returning (values acc line col) — works since loop's body returns values in all branches? In numeric branch, `scan` inner returns loop's result via tail position — yes inside begin. In keyword branch same. OK. But `(define lex ...)` inside begin after an expression is invalid: (begin (define lex ...) (loop ...)) is allowed in Racket? Internal defines inside begin at expression level: yes, (begin (define x 1) x) is allowed in a body context. Inside let/cond branch which is a body context — allowed. To be safe, restructure: `(let ([lex (substring src i j)]) (loop j line (+ col (- j i)) (cons (tok ...) acc)))`. Safer. I'll do that everywhere.

token-dump-line: (format "TOKEN ~a ~a:~a ~s" (tok-type t) (tok-line t) (tok-col t) (tok-lexeme t)).

