MODULE Arithmetic
TYPE Word = UNSIGNED 64
FUNCTOR Multiply
  ACCEPT UNSIGNED 64 a
  ACCEPT UNSIGNED 64 b
  RETURN UNSIGNED 64
  EXECUTE
    a TIMES b INTO RESULT
  END
  PROVE
    RESULT EQUALS a TIMES b
  END
END
PROGRAM Main
  LET x BE 12
  LET y BE 8
  INVOKE Multiply WITH x, y
  ASSERT RESULT EQUALS 96
END
